/* styles.css */
:root{
  --bg0:#07162f;
  --bg1:#0a2346;
  --card:#0d2b56;
  --card2:#0b2142;
  --text:#eaf2ff;
  --muted:#b9c8e6;
  --line:rgba(255,255,255,.12);
  --accent:#ff7a18;
  --accent2:#66ccff;
  --good:#37d67a;
  --warn:#ffd166;
  --bad:#ff4d6d;

  --shadow: 0 12px 40px rgba(0,0,0,.35);
  --radius: 22px;
  --radius2: 16px;
  --maxw: 1100px;
}

*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0;
  font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  color:var(--text);
  background:
    radial-gradient(1200px 700px at 20% 15%, rgba(102,204,255,.25), transparent 60%),
    radial-gradient(900px 600px at 80% 20%, rgba(255,122,24,.18), transparent 60%),
    linear-gradient(180deg, var(--bg0), var(--bg1));
  overflow:hidden;
}

a{color:inherit}
.app{height:100%; display:flex; flex-direction:column}

.topbar{
  display:flex; align-items:center; justify-content:space-between;
  padding:14px 18px;
  border-bottom:1px solid var(--line);
  background: rgba(0,0,0,.18);
  backdrop-filter: blur(10px);
}
.brand{display:flex; gap:12px; align-items:center}
.brand__mark{
  width:46px; height:46px; border-radius:14px;
  display:grid; place-items:center;
  background: linear-gradient(135deg, rgba(255,122,24,.95), rgba(102,204,255,.85));
  color:#07162f; font-weight:900; letter-spacing:.5px;
}
.brand__title{font-weight:800; font-size:14px; letter-spacing:.2px}
.brand__subtitle{font-size:12px; color:var(--muted)}
.topbar__right{display:flex; gap:10px; align-items:center}

.chip{
  border:1px solid var(--line);
  padding:8px 10px;
  border-radius:999px;
  color:var(--muted);
  background: rgba(255,255,255,.04);
  font-size:12px;
}
.chip strong{color:var(--text)}

.btn{
  border:1px solid var(--line);
  background: rgba(255,255,255,.06);
  color:var(--text);
  padding:10px 12px;
  border-radius:999px;
  cursor:pointer;
  font-weight:700;
  letter-spacing:.2px;
  transition: transform .05s ease, background .2s ease, border .2s ease;
}
.btn:hover{background: rgba(255,255,255,.10)}
.btn:active{transform: translateY(1px)}
.btn--ghost{background: rgba(255,255,255,.03)}
.btn--accent{
  border-color: rgba(255,122,24,.45);
  background: linear-gradient(135deg, rgba(255,122,24,.95), rgba(255,122,24,.65));
  color:#061427;
}
.btn--accent:hover{filter:brightness(1.03)}

.deck{
  flex:1;
  position:relative;
  display:grid;
  place-items:center;
  padding:22px;
}
.slide{
  width:min(var(--maxw), calc(100vw - 44px));
  height:min(74vh, 720px);
  border-radius: var(--radius);
  background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.03));
  border: 1px solid var(--line);
  box-shadow: var(--shadow);
  overflow:hidden;
  position:absolute;
  inset:auto;
  opacity:0;
  transform: translateY(18px) scale(.985);
  transition: opacity .25s ease, transform .25s ease;
  display:flex;
  flex-direction:column;
}
.slide.is-active{
  opacity:1;
  transform: translateY(0) scale(1);
  position:relative;
}
.slide__inner{
  padding:26px;
  display:flex;
  flex-direction:column;
  gap:18px;
  height:100%;
}
.kicker{
  display:flex; gap:10px; align-items:center; flex-wrap:wrap;
  color:var(--muted); font-weight:700; font-size:12px;
}
.kicker .dot{
  width:8px; height:8px; border-radius:50%;
  background: var(--accent2);
  box-shadow: 0 0 0 4px rgba(102,204,255,.12);
}
.h1{
  font-size:44px;
  line-height:1.05;
  margin:0;
  letter-spacing:-.6px;
}
.h2{
  font-size:26px;
  margin:0;
  letter-spacing:-.2px;
}
.p{
  margin:0;
  color:var(--muted);
  font-size:16px;
  line-height:1.45;
  max-width:72ch;
}
.grid{
  display:grid;
  gap:12px;
}
.grid.cols-2{grid-template-columns: repeat(2, minmax(0,1fr))}
.grid.cols-3{grid-template-columns: repeat(3, minmax(0,1fr))}
@media (max-width: 860px){
  .grid.cols-2,.grid.cols-3{grid-template-columns:1fr}
  .h1{font-size:36px}
  body{overflow:hidden}
}

.card{
  border:1px solid var(--line);
  background: rgba(7,22,47,.55);
  border-radius: var(--radius2);
  padding:14px 14px;
}
.card--soft{background: rgba(255,255,255,.05)}
.card__title{font-weight:800; margin:0 0 6px 0}
.card__meta{color:var(--muted); font-size:13px; line-height:1.35}
.badge{
  display:inline-flex; align-items:center; gap:8px;
  padding:6px 10px;
  border-radius:999px;
  border:1px solid var(--line);
  background: rgba(255,255,255,.04);
  color:var(--muted);
  font-size:12px;
  font-weight:700;
}
.badge b{color:var(--text)}
.badge--accent{border-color: rgba(255,122,24,.45)}
.badge--good{border-color: rgba(55,214,122,.45)}
.badge--warn{border-color: rgba(255,209,102,.45)}
.badge--bad{border-color: rgba(255,77,109,.45)}

.row{display:flex; gap:10px; flex-wrap:wrap; align-items:center}
.spacer{flex:1}
.hr{height:1px; background: var(--line); width:100%}

.list{
  margin:0; padding:0; list-style:none;
  display:flex; flex-direction:column; gap:10px;
}
.item{
  display:flex; gap:12px; align-items:flex-start;
  padding:12px;
  border-radius:16px;
  border:1px solid var(--line);
  background: rgba(255,255,255,.04);
}
.item__icon{
  width:38px; height:38px; border-radius:14px;
  display:grid; place-items:center;
  background: rgba(102,204,255,.14);
  border:1px solid rgba(102,204,255,.25);
  flex:0 0 auto;
}
.item__txt{display:flex; flex-direction:column; gap:4px}
.item__t{font-weight:800}
.item__d{color:var(--muted); font-size:13px; line-height:1.35}
.item button.link{
  margin-left:auto;
  border:none; background:none; color:var(--accent2);
  font-weight:800; cursor:pointer;
}

.callout{
  padding:14px 16px;
  border-radius: 18px;
  border:1px solid rgba(255,122,24,.35);
  background: linear-gradient(135deg, rgba(255,122,24,.12), rgba(102,204,255,.08));
}
.callout strong{color:var(--text)}
.callout p{margin:6px 0 0 0; color:var(--muted)}

.bottombar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:12px 18px;
  border-top:1px solid var(--line);
  background: rgba(0,0,0,.18);
  backdrop-filter: blur(10px);
}
.bottombar__left{display:flex; align-items:center; gap:10px; width:55%}
.bottombar__right{display:flex; align-items:center; gap:10px}

.progress{
  flex:1;
  height:10px;
  border-radius:999px;
  border:1px solid var(--line);
  background: rgba(255,255,255,.04);
  overflow:hidden;
}
.progress__bar{
  height:100%;
  background: linear-gradient(90deg, rgba(102,204,255,.95), rgba(255,122,24,.9));
  width:0%;
}

kbd{
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
  border:1px solid var(--line);
  border-bottom-color: rgba(255,255,255,.2);
  background: rgba(255,255,255,.06);
  border-radius:8px;
  padding:2px 6px;
  font-size:12px;
  color:var(--text);
}

.input, .select{
  width:100%;
  border:1px solid var(--line);
  background: rgba(255,255,255,.04);
  color: var(--text);
  border-radius: 14px;
  padding:10px 12px;
  font-size:14px;
  outline:none;
}
.range{
  width:100%;
}
.small{font-size:12px; color:var(--muted)}

.pills{display:flex; flex-wrap:wrap; gap:8px}
.pill{
  border:1px solid var(--line);
  border-radius:999px;
  padding:8px 10px;
  background: rgba(255,255,255,.04);
  font-weight:800;
  font-size:12px;
  cursor:pointer;
  user-select:none;
}
.pill.is-on{
  border-color: rgba(102,204,255,.55);
  background: rgba(102,204,255,.12);
}

.embed{
  width:100%;
  height:360px;
  border:1px solid var(--line);
  border-radius: 18px;
  overflow:hidden;
  background: rgba(0,0,0,.2);
}
.embed iframe{
  width:100%;
  height:100%;
  border:0;
}

/* Modal */
.modal{position:fixed; inset:0; display:none}
.modal[aria-hidden="false"]{display:block}
.modal__backdrop{
  position:absolute; inset:0;
  background: rgba(0,0,0,.55);
}
.modal__panel{
  position:relative;
  width:min(860px, calc(100vw - 24px));
  max-height: calc(100vh - 24px);
  margin: 12px auto;
  border-radius: 22px;
  border:1px solid var(--line);
  background: linear-gradient(180deg, rgba(7,22,47,.98), rgba(10,35,70,.98));
  box-shadow: var(--shadow);
  overflow:hidden;
  display:flex;
  flex-direction:column;
}
.modal__head, .modal__foot{
  padding:14px 16px;
  display:flex; align-items:center; justify-content:space-between;
  border-bottom:1px solid var(--line);
}
.modal__foot{border-top:1px solid var(--line); border-bottom:none; justify-content:flex-end; gap:10px}
.modal__title{font-weight:900}
.modal__body{
  padding:16px;
  overflow:auto;
  color:var(--text);
}

/* Drawer */
.drawer{position:fixed; inset:0; display:none}
.drawer[aria-hidden="false"]{display:block}
.drawer__backdrop{position:absolute; inset:0; background: rgba(0,0,0,.55)}
.drawer__panel{
  position:absolute; top:0; right:0;
  height:100%;
  width:min(460px, 92vw);
  background: linear-gradient(180deg, rgba(7,22,47,.98), rgba(10,35,70,.98));
  border-left:1px solid var(--line);
  box-shadow: var(--shadow);
  display:flex; flex-direction:column;
}
.drawer__head{
  padding:14px 16px;
  display:flex; align-items:center; justify-content:space-between;
  border-bottom:1px solid var(--line);
}
.drawer__title{font-weight:900}
.drawer__body{padding:14px 16px; overflow:auto}
.toc{
  display:flex; flex-direction:column; gap:10px;
}
.toc__btn{
  text-align:left;
  border:1px solid var(--line);
  background: rgba(255,255,255,.04);
  color: var(--text);
  padding:12px 12px;
  border-radius: 16px;
  cursor:pointer;
  font-weight:800;
}
.toc__btn small{display:block; font-weight:600; color:var(--muted); margin-top:4px}
